{
  "name": "typescript_local_ai",
  "version": "0.1.0",
  "description": "Local, OS-native AI for TypeScript: browser Prompt API and Node, with React, Vue, Svelte and Next.js adapters.",
  "license": "MIT",
  "homepage": "https://vezz.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kekko7072/typescript_local_ai.git"
  },
  "keywords": [
    "ai",
    "local-ai",
    "on-device",
    "prompt-api",
    "gemini-nano",
    "react",
    "vue",
    "svelte",
    "nextjs"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/browser.js",
    "./dist/node.js"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/browser.d.ts",
      "browser": "./dist/browser.js",
      "node": "./dist/node.js",
      "default": "./dist/browser.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "default": "./dist/vue/index.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "default": "./dist/svelte/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "default": "./dist/next/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:package": "publint --strict",
    "smoke": "node scripts/smoke.mjs && node --conditions=react-server scripts/smoke-next.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run lint:package && npm run smoke",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "server-only": "^0.0.1"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18",
    "svelte": ">=4",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^26.1.0",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svelte": "^5.57.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vue": "^3.5.43"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/kekko7072/typescript_local_ai/issues"
  },
  "author": "Francesco Vezzani"
}
